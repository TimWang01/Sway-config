# Sway configuration
#
# Read `man 5 sway` for a complete reference.

### Variables
# Mod key (Mod4 = Super/Win; Mod1 = Alt)
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# --- Paths ---
# Helper scripts directory
set $scripts ~/.config/sway/scripts
# Wallpaper image
set $wallpaper ~/.config/wallpaper

# --- Applications ---
# Terminal emulator
set $term foot
# Application launcher
# Note: pass the final command to swaymsg so that the resulting window can be opened
# on the original workspace that the command was run on.
set $rofi_cmd rofi \
        -terminal '$term'
set $menu $rofi_cmd -show combi -combi-modes drun#run -modes combi
set $browser firefox
set $file-manager $scripts/dolphin-wrapper.sh
set $calc flatpak run org.kde.kcalc
set $calendar korganizer
set $password-manager flatpak run org.keepassxc.KeePassXC
set $mixer pavucontrol

# --- Lock screen ---
set $lock exec $scripts/lock-screen.sh

# --- Audio/OSD control ---
set $swayosd swayosd-client

# --- Display ---
# Primary output name (see: swaymsg -t get_outputs) and its mode
set $primary_output DP-2
set $primary_res 2560x1440@144Hz

# --- Appearance ---
set $font pango:Century Gothic Bold 10
set $border_width 4
set $resize_step 10px
set $workspace_layout tabbed

# --- Nord palette (titlebar colors) ---
set $nord0 #2E3440
set $nord1 #3B4252
set $nord3 #4C566A
set $nord4 #D8DEE9
set $nord6 #ECEFF4
set $nord8 #88C0D0
set $nord11 #BF616A
# Custom dimmed/deep variants for inactive/unfocused states
set $nord-dim #353C4A
set $nord-deep #1F2329

# --- Input ---
set $pointer_accel 0
set $repeat_delay 250

### Output configuration
output * bg $wallpaper fill
# You can get the names of your outputs by running: swaymsg -t get_outputs
output $primary_output mode $primary_res adaptive_sync on
# Composite 1ms before refresh → lower input latency (official tuning start;
# bump by 1 only if frame drops appear; values >3ms degrade VRR on RDNA2)
output $primary_output max_render_time 1
# Allow screen tearing for fullscreen apps that request it (async page flips).
# Only active when window is fullscreen + app allows it; no cost when idle.
output $primary_output allow_tearing yes

### Idle configuration
# swayidle config is in config.d/90-swayidle.conf

### Input configuration
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information.

### Key bindings
# Basics
    # Terminal
    bindsym $mod+Escape exec $term btop
    bindsym $mod+Alt+r exec $term

    # Lock screen
    bindsym $mod+l $lock

    # Toggle keep-awake (logind idle inhibitor — disables swayidle lock/suspend cascade)
    bindsym --locked $mod+Ctrl+l exec $scripts/keep-awake-toggle.sh

    # Kill focused window
    bindsym $mod+q kill

    # Force-kill focused window (SIGKILL, no save prompts)
    bindsym $mod+Shift+q exec $scripts/force-kill.sh

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Alt+l exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    floating_modifier $mod normal

# Volume control — output
    bindsym --locked $mod+minus exec $swayosd --output-volume -5
    bindsym --locked $mod+equal exec $swayosd --output-volume 5
    bindsym --locked $mod+backslash exec $swayosd --output-volume mute-toggle
# Volume control — input
    bindsym --locked $mod+Shift+minus exec $swayosd --input-volume -5
    bindsym --locked $mod+Shift+equal exec $swayosd --input-volume 5
    bindsym --locked $mod+Shift+backslash exec $swayosd --input-volume mute-toggle

# Media control
    bindsym --locked $mod+Ctrl+x exec $swayosd --playerctl play-pause
    bindsym --locked $mod+Ctrl+c exec $swayosd --playerctl next
    bindsym --locked $mod+Ctrl+z exec $swayosd --playerctl prev

# Launch applications
    bindsym $mod+r exec $menu
    bindsym $mod+b exec $browser
    bindsym $mod+c exec $calc
    bindsym $mod+Alt+c exec $calendar
    bindsym $mod+e exec $file-manager
    bindsym $mod+Alt+backslash exec $password-manager

    # Toggle night light
    bindsym $mod+End exec $scripts/night-light-toggle.sh

    # Audio mixer
    bindsym $mod+Alt+a exec $mixer

    # Toggle notifications (do-not-disturb)
    bindsym $mod+Ctrl+n exec $scripts/dnd-toggle.sh

# Moving around
    # Move your focus around (WASD)
    bindsym $mod+w focus up
    bindsym $mod+a focus left
    bindsym $mod+s focus down
    bindsym $mod+d focus right
    # Or use arrow keys
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with Shift+WASD
    bindsym $mod+Shift+w move up
    bindsym $mod+Shift+a move left
    bindsym $mod+Shift+s move down
    bindsym $mod+Shift+d move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

    # Cycle through tabs in the focused tabbed container
    bindsym Alt+Tab focus right
    bindsym Alt+Shift+Tab focus left

# Workspaces
    # Switch to last workspace
    bindsym $mod+Tab workspace back_and_forth

    # Switch to the lowest unused workspace number
    bindsym $mod+Alt+Tab exec $scripts/next-empty-workspace.sh

    # Move focused container to the lowest unused workspace number
    bindsym $mod+Alt+Shift+Tab exec $scripts/next-empty-workspace.sh move

    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+Alt+1 workspace number 11
    bindsym $mod+Alt+2 workspace number 12
    bindsym $mod+Alt+3 workspace number 13
    bindsym $mod+Alt+4 workspace number 14
    bindsym $mod+Alt+5 workspace number 15

    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+Alt+1 move container to workspace number 11
    bindsym $mod+Shift+Alt+2 move container to workspace number 12
    bindsym $mod+Shift+Alt+3 move container to workspace number 13
    bindsym $mod+Shift+Alt+4 move container to workspace number 14
    bindsym $mod+Shift+Alt+5 move container to workspace number 15

# Layout
    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Default layout for new workspaces: tabs instead of side-by-side stacking
workspace_layout $workspace_layout

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Alt+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+Ctrl+space focus mode_toggle

    # Single window on a workspace → no gaps, no borders (max content)
    smart_gaps on
    smart_borders on

# Scratchpad
    # Move the currently focused window to the scratchpad
    bindsym $mod+m move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+n scratchpad show

# Resizing containers
    mode "resize" {
        # left will shrink the containers width
        # right will grow the containers width
        # up will shrink the containers height
        # down will grow the containers height
        bindsym $left resize shrink width $resize_step
        bindsym $down resize grow height $resize_step
        bindsym $up resize shrink height $resize_step
        bindsym $right resize grow width $resize_step

        # Ditto, with arrow keys
        bindsym Left resize shrink width 10px
        bindsym Down resize grow height 10px
        bindsym Up resize shrink height 10px
        bindsym Right resize grow width 10px

        # Return to default mode
        bindsym Return mode "default"
        bindsym Escape mode "default"
    }

# Floating window rules
    for_window [app_id="org.keepassxc.KeePassXC"] floating enable
    for_window [app_id="com.valvesoftware.Steam"] floating enable
    for_window [class="(?i)steam"] floating enable
    # Dialogs (open/save windows, etc.) float instead of wrecking the tiling layout
    for_window [window_type="dialog"] floating enable

# Include configs from 3 locations:
#  - /usr/share/sway/config.d
#  - /etc/sway/config.d
#  - $XDG_CONFIG_HOME/sway/config.d ($HOME/.config/sway/config.d)
#
# If multiple directories contain the files with the same name, the later
# directory takes precedence; `$XDG_CONFIG_HOME/sway/config.d/20-swayidle.conf`
# will always be loaded instead of `/usr/share/sway/config.d/20-swayidle.conf`
# or `/etc/sway/config.d/20-swayidle.conf`
#
# This mechanism permits overriding our default configuration per-system
# (/etc) or per-user ($XDG_CONFIG_HOME) basis. Just create the file you
# want to modify/override in the higher-level directory.
#
# For example, to disable the default bar from Fedora configs, you'll need to
#     $ echo -n > "$HOME/.config/sway/config.d/90-bar.conf"
#
# Note the quoting, the $() and the arguments quoting. All the parts are equally
# important to make the magic work. And if you want to learn the secret behind
# the trick, it's all in the `wordexp(3)`.
#
# NOTE: everything below this include takes precedence over config.d defaults.
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'

### Input (overrides config.d defaults)
input * {
    left_handed disabled
    tap enabled
    natural_scroll disabled
    dwt enabled
    accel_profile "flat" # disable mouse acceleration (enabled by default; to set it manually, use "adaptive" instead of "flat")
    pointer_accel $pointer_accel # set mouse sensitivity (between -1 and 1)
    repeat_delay $repeat_delay
}

### Autostart
exec $scripts/night-light-toggle.sh
exec swayosd-server
exec_always systemctl --user set-environment KDE_SESSION_VERSION=6 XDG_CURRENT_DESKTOP=KDE
exec_always fcitx5 -d --replace

### Behavior
focus_follows_mouse no
# Don't let windows steal focus on activation — flash urgent instead
focus_on_window_activation urgent
# Don't yank attention out of fullscreen apps when popups appear
popup_during_fullscreen smart

### Window appearance
# Thin window frame; smart_borders hides it when a window is alone on a workspace
default_border pixel $border_width
default_floating_border none
font $font
titlebar_padding 5 4
titlebar_border_thickness 1
# Center the title text in the title bar / tabs
title_align center
# Nord titlebar colors (client.<class> border background text indicator child_border)
client.focused          $nord3 $nord1 $nord4 $nord8 $nord3
client.focused_inactive $nord-dim $nord-dim $nord4 $nord8 $nord-dim
client.unfocused        $nord-deep $nord0 $nord4 $nord3 $nord-deep
client.urgent           $nord11 $nord11 $nord6 $nord11 $nord11
client.placeholder      $nord1 $nord1 $nord4 $nord3 $nord1
# i3-compatible: hide the tab/stack title bar when a container has only one child
hide_edge_borders --i3 none

### Bar
# Hold modifier key to show waybar
bar {
    swaybar_command waybar
    position top
    mode hide
    modifier $mod
}
